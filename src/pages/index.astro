---
import StandaloneLayout from "../layouts/StandaloneLayout.astro";
import { coursesData } from "@/components/CoursesListing";
import { courseDirOf, lessonCountFor, totalLessons } from "../lib/course-stats.mjs";
import { CHEATSHEET_DATA, TOTAL_COMMANDS } from "../data/cheatsheets";

// Lesson counts on the hand-built cards below come from the sidebar, so they
// stay right when lessons are added. They were hand-typed and had drifted
// (the JavaScript card said 9; the course has 36).
const lessons = (href: string) => lessonCountFor(courseDirOf(href));

// Homepage cheat sheet cards, built from the same data as /cheatsheets. Each
// card deep-links to its category, so the teaser can never list a category the
// page doesn't have, or miss one it does.
const cheatsheetCards = CHEATSHEET_DATA.map((section) => ({
  id: section.id,
  sigil: section.sigil,
  title: section.title,
  hint: [...new Set(section.items.map((item) => item.tag).filter(Boolean))]
    .slice(0, 3)
    .join(", "),
  count: section.items.length,
}));

// Latest & recently expanded flagship courses rendered on the homepage, backed
// by coursesData and sidebar lesson counts so titles/descriptions/counts never drift.
const LATEST_FEATURED_SPECS = [
  {
    id: "ai-agents",
    badge: "NEW",
    badgeClass:
      "bg-purple-100 dark:bg-purple-900/50 text-purple-800 dark:text-purple-300",
    iconGradient: "from-purple-600 to-fuchsia-500 shadow-purple-500/25",
    cardHover: "hover:shadow-purple-500/10",
    titleHover: "group-hover:text-purple-600 dark:group-hover:text-purple-400",
    iconPath: "M13 10V3L4 14h7v7l9-11h-7z",
  },
  {
    id: "python-datascience",
    badge: "NEW",
    badgeClass:
      "bg-emerald-100 dark:bg-emerald-900/50 text-emerald-800 dark:text-emerald-300",
    iconGradient: "from-emerald-600 to-teal-500 shadow-emerald-500/25",
    cardHover: "hover:shadow-emerald-500/10",
    titleHover: "group-hover:text-emerald-600 dark:group-hover:text-emerald-400",
    iconPath:
      "M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z",
  },
  {
    id: "linux-devops",
    badge: "NEW",
    badgeClass:
      "bg-orange-100 dark:bg-orange-900/50 text-orange-800 dark:text-orange-300",
    iconGradient: "from-orange-600 to-amber-500 shadow-orange-500/25",
    cardHover: "hover:shadow-orange-500/10",
    titleHover: "group-hover:text-orange-600 dark:group-hover:text-orange-400",
    iconPath:
      "M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  },
  {
    id: "docker",
    badge: "Updated",
    badgeClass: "bg-sky-100 dark:bg-sky-900/50 text-sky-800 dark:text-sky-300",
    iconGradient: "from-sky-600 to-blue-500 shadow-sky-500/25",
    cardHover: "hover:shadow-sky-500/10",
    titleHover: "group-hover:text-sky-600 dark:group-hover:text-sky-400",
    iconPath:
      "M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4",
  },
  {
    id: "nextjs",
    badge: "Updated",
    badgeClass:
      "bg-indigo-100 dark:bg-indigo-900/50 text-indigo-800 dark:text-indigo-300",
    iconGradient: "from-indigo-600 to-violet-600 shadow-indigo-500/25",
    cardHover: "hover:shadow-indigo-500/10",
    titleHover: "group-hover:text-indigo-600 dark:group-hover:text-indigo-400",
    iconPath:
      "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9",
  },
  {
    id: "nodejs",
    badge: "Updated",
    badgeClass:
      "bg-green-100 dark:bg-green-900/50 text-green-800 dark:text-green-300",
    iconGradient: "from-green-600 to-emerald-500 shadow-green-500/25",
    cardHover: "hover:shadow-green-500/10",
    titleHover: "group-hover:text-green-600 dark:group-hover:text-green-400",
    iconPath: "M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4",
  },
];

const latestFeaturedCourses = LATEST_FEATURED_SPECS.map((spec) => {
  const course = coursesData.find((c) => c.id === spec.id);
  if (!course) {
    throw new Error(`Homepage featured course missing from coursesData: ${spec.id}`);
  }
  return {
    ...spec,
    href: `/${course.dir}`,
    title: course.title,
    description: course.description,
    estimatedTime: course.estimatedTime,
    lessonCount: lessonCountFor(course.dir),
  };
});

// Overview learning-path diagram rendered in the "Where to Start" section.
const OVERVIEW_FOUNDATIONS = [
  { label: "HTML & CSS", href: "/html", tag: "Web UI" },
  { label: "JavaScript", href: "/javascript", tag: "Web Logic" },
  { label: "Python", href: "/python", tag: "Core Coding" },
  { label: "Git & GitHub", href: "/git-course", tag: "Workflow" },
];

const OVERVIEW_TRACKS = [
  {
    id: "Track A",
    title: "Full-Stack Web",
    subtitle: "Frontend + APIs + SSR",
    borderClass: "border-amber-500/35",
    badgeClass:
      "bg-amber-100 dark:bg-amber-900/50 text-amber-800 dark:text-amber-300",
    stepHover: "hover:border-amber-500/60 hover:text-amber-700 dark:hover:text-amber-300",
    steps: [
      { label: "CSS & Layout", href: "/css" },
      { label: "TypeScript", href: "/typescript" },
      { label: "Node.js & Express", href: "/nodejs" },
      { label: "Next.js App Router", href: "/nextjs" },
    ],
  },
  {
    id: "Track B",
    title: "AI & Automation",
    subtitle: "Agents + Data + Scraping",
    borderClass: "border-purple-500/35",
    badgeClass:
      "bg-purple-100 dark:bg-purple-900/50 text-purple-800 dark:text-purple-300",
    stepHover: "hover:border-purple-500/60 hover:text-purple-700 dark:hover:text-purple-300",
    steps: [
      { label: "AI Proficiency", href: "/ai-proficiency" },
      { label: "n8n Workflows", href: "/n8n-course" },
      { label: "Python Data & Scraping", href: "/python-datascience" },
      { label: "AI Agents & RAG", href: "/ai-agents" },
    ],
  },
  {
    id: "Track C",
    title: "Backend & DevOps",
    subtitle: "Databases + Cloud + Scale",
    borderClass: "border-cyan-500/35",
    badgeClass: "bg-sky-100 dark:bg-sky-900/50 text-sky-800 dark:text-sky-300",
    stepHover: "hover:border-sky-500/60 hover:text-sky-700 dark:hover:text-sky-300",
    steps: [
      { label: "SQL & Relational DB", href: "/sql-course" },
      { label: "MongoDB NoSQL", href: "/mongodb-course" },
      { label: "Docker & Linux VPS", href: "/linux-devops" },
      { label: "Software Architecture", href: "/software-architecture" },
    ],
  },
];

const OVERVIEW_LEVEL_UP = [
  { label: "Data Structures & Algorithms", href: "/dsa" },
  { label: "Web Performance", href: "/web-performance" },
  { label: "Cheat Sheets Hub", href: "/cheatsheets" },
];
---

<StandaloneLayout
  title="တက္ကသိုလ် - Myanmar Programming Learning Platform"
  description="မြန်မာဘာသာဖြင့် programming သင်ခန်းစာများကို လေ့လာပါ။ AI Agents, Python Data Science, Linux DevOps, Docker, Next.js, TypeScript နှင့် အခြား နည်းပညာများ"
>
  <div class="neo-page neo-home">
    <!-- Hero Section -->
    <section class="neo-hero relative overflow-hidden">
      <!-- Animated Background -->
      <div
        class="absolute inset-0 bg-gradient-to-br from-gray-50 via-white to-gray-50 dark:from-orange-950/40 dark:via-gray-950/80 dark:to-gray-900/80"
      >
      </div>
      <canvas
        id="matrix-canvas"
        class="absolute inset-0 w-full h-full pointer-events-none opacity-60 dark:opacity-80 mix-blend-multiply dark:mix-blend-screen"
      ></canvas>

      <!-- Gradient Orbs -->
      <div
        class="absolute top-20 left-10 w-72 h-72 bg-amber-400/20 dark:bg-amber-500/10 rounded-full blur-3xl animate-pulse"
      >
      </div>
      <div
        class="absolute bottom-20 right-10 w-96 h-96 bg-orange-400/20 dark:bg-orange-500/10 rounded-full blur-3xl animate-pulse"
        style="animation-delay: 1s;"
      >
      </div>
      <div
        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-yellow-400/10 dark:bg-yellow-500/5 rounded-full blur-3xl"
      >
      </div>

      <div
        class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32"
      >
        <div class="text-center">
          <!-- Main Heading -->
          <h1
            class="text-4xl sm:text-5xl lg:text-7xl font-bold mb-6 leading-tight relative"
          >
            <span
              class="text-orange-600 dark:text-orange-500 drop-shadow-[0_0_25px_rgba(234,88,12,0.4)]"
              >တက္ကသိုလ်</span
            >
            <br />
          </h1>

          <!-- Subtitle -->
          <p
            class="text-lg sm:text-xl text-gray-700 dark:text-gray-300 max-w-3xl mx-auto mb-10 leading-relaxed font-medium"
          >
            <span
              class="inline-block py-2 bg-gradient-to-r from-amber-600 via-orange-600 to-red-600 dark:from-amber-400 dark:via-orange-400 dark:to-red-400 bg-clip-text text-transparent"
            >
              မိမိဘာသာစကားဖြင့် နက်နက်ရှိုင်းရှိုင်းနားလည်အောင် လေ့လာပါ။
            </span>
          </p>

          <!-- CTA Buttons -->
          <div
            class="hero-cta flex flex-wrap items-center justify-center gap-3 mb-16 relative z-10"
          >
            <a
              href="/courses"
              class="neo-btn group flex items-center py-3.5 px-6 gap-2.5 bg-orange-700 hover:bg-orange-800 text-white font-semibold text-base hover:-translate-y-0.5 transition-all duration-300 shadow-lg shadow-orange-500/25 rounded-2xl"
            >
              <span>သင်ခန်းစာများ</span>
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
            <a
              href="/roadmaps"
              class="neo-btn group flex items-center py-3.5 px-6 gap-2.5 bg-white/80 backdrop-blur-md dark:bg-stone-900/80 border border-gray-200 dark:border-stone-800 text-gray-800 dark:text-gray-200 font-semibold text-base hover:-translate-y-0.5 transition-all duration-300 rounded-2xl hover:border-orange-500/50"
            >
              <span>Career Roadmaps</span>
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform text-orange-600 dark:text-orange-400"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
              </svg>
            </a>
            <a
              href="/about"
              class="neo-btn group flex items-center py-3.5 px-6 gap-2.5 bg-white/80 backdrop-blur-md dark:bg-stone-900/80 border border-gray-200 dark:border-stone-800 text-gray-800 dark:text-gray-200 font-semibold text-base hover:-translate-y-0.5 transition-all duration-300 rounded-2xl hover:border-orange-500/50"
            >
              <span>ကျွန်ုပ်တို့အကြောင်း</span>
              <svg
                class="w-4 h-4 group-hover:translate-x-1 transition-transform text-orange-500"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
              </svg>
            </a>
          </div>

          {/*
            Continue learning. Lesson pages record the last lesson opened
            (see RECORD_LAST_LESSON in astro.config.mjs). This stays hidden for
            new visitors; for returning ones the inline script fills it in while
            the page is still parsing, so it appears without shifting the layout.
          */}
          <div id="continue-learning" class="relative z-10 -mt-8 mb-12" hidden>
            <a
              id="continue-learning-link"
              href="/courses"
              class="group inline-flex max-w-full items-center gap-3 rounded-2xl border border-orange-500/25 bg-white/80 dark:bg-stone-900/70 px-4 py-3 text-left shadow-sm backdrop-blur-md transition-colors hover:border-orange-500/60"
            >
              <span class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-xl bg-orange-700 text-white" aria-hidden="true">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
              </span>
              <span class="min-w-0">
                <span class="block text-xs font-semibold text-orange-700 dark:text-orange-400">ဆက်လေ့လာရန်</span>
                <span id="continue-learning-title" class="block truncate text-sm font-semibold text-gray-900 dark:text-white"></span>
                <span id="continue-learning-course" class="block truncate text-xs text-gray-600 dark:text-gray-400"></span>
              </span>
            </a>
          </div>
          <script is:inline>
            (() => {
              try {
                const data = JSON.parse(localStorage.getItem("takkatho-last-lesson") || "null");
                // Same-site paths only ("/x", never "//host"), and nothing stale.
                const fresh = data && Date.now() - Number(data.at) < 180 * 86_400_000;
                if (!fresh || typeof data.path !== "string" || !/^\/(?!\/)/.test(data.path)) return;
                document.getElementById("continue-learning-link").href = data.path;
                document.getElementById("continue-learning-title").textContent = String(data.title || "");
                document.getElementById("continue-learning-course").textContent = String(data.course || "");
                document.getElementById("continue-learning").hidden = false;
              } catch {
                // Blocked storage or a malformed entry: show nothing.
              }
            })();
          </script>

          <!-- Stats -->
          <div
            class="neo-stats inline-flex flex-wrap items-center justify-center gap-8 md:gap-12 px-8 py-6 relative z-10"
          >
            <div class="text-center">
              <div
                class="text-3xl md:text-4xl font-bold text-orange-600 dark:text-orange-400"
              >
                {coursesData.length}
              </div>
              <div
                class="text-sm text-orange-800/70 dark:text-orange-300/70 mt-1"
              >
                Courses
              </div>
            </div>
            <div class="w-px h-12 bg-orange-200/60 dark:bg-orange-900/50"></div>
            <div class="text-center">
              <div
                class="text-3xl md:text-4xl font-bold text-orange-600 dark:text-orange-400"
              >
                {totalLessons}
              </div>
              <div
                class="text-sm text-orange-800/70 dark:text-orange-300/70 mt-1"
              >
                Lessons
              </div>
            </div>
            <div
              class="w-px h-12 bg-orange-200/60 dark:bg-orange-900/50 hidden sm:block"
            >
            </div>
            <div class="text-center hidden sm:block">
              <div
                class="text-3xl md:text-4xl font-bold text-orange-600 dark:text-orange-400"
              >
                100%
              </div>
              <div
                class="text-sm text-orange-800/70 dark:text-orange-300/70 mt-1"
              >
                Free
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Where to Start Diagram Overview Section -->
    <section class="py-16 dark:bg-[#0c0a09] neo-alt relative">
      <div
        class="absolute inset-0 bg-[linear-gradient(to_right,#f9731610_1px,transparent_1px),linear-gradient(to_bottom,#f9731610_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_50%,#000_70%,transparent_100%)]"
      >
      </div>
      <div
        class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10"
      >
        <h2
          class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4"
        >
          ဘယ်ကနေ စတင်လေ့လာရမလဲ?
        </h2>
        <p class="text-base sm:text-lg text-gray-700 dark:text-gray-300 max-w-3xl mx-auto mb-10 font-medium">
          Programming အခြေခံမှစပြီး ခင်ဗျား ရွေးချယ်လိုသည့် Career လမ်းကြောင်းအထိ
          အဆင့်ဆင့် တက်လှမ်းနိုင်မည့် Learning Overview Diagram (Course တစ်ခုချင်းစီကို နှိပ်၍ တိုက်ရိုက် ဝင်ဖတ်နိုင်ပါတယ်)
        </p>

        <!-- Diagram Canvas -->
        <div
          class="rounded-3xl p-5 sm:p-8 bg-white/85 dark:bg-stone-950/75 border border-orange-500/20 backdrop-blur-xl shadow-2xl shadow-orange-500/10 dark:shadow-orange-500/5"
        >
          <!-- Stage 1: Foundations Root Node -->
          <div
            class="max-w-3xl mx-auto rounded-2xl border-2 border-orange-500/35 bg-gradient-to-br from-orange-500/10 via-amber-500/5 to-transparent p-4 sm:p-5"
          >
            <div class="flex flex-wrap items-center justify-center gap-2 mb-3">
              <span
                class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-orange-700 text-white"
              >
                Step 1 · Start Here
              </span>
              <span class="text-sm font-bold text-gray-900 dark:text-white">
                Core Foundations (အခြေခံ အုတ်မြစ်)
              </span>
            </div>
            <div class="flex flex-wrap items-center justify-center gap-2.5">
              {
                OVERVIEW_FOUNDATIONS.map((item, idx) => (
                  <>
                    <a
                      href={item.href}
                      class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white dark:bg-stone-900 border border-orange-500/25 hover:border-orange-500 text-sm font-semibold text-gray-900 dark:text-white shadow-sm hover:-translate-y-0.5 transition-all"
                    >
                      <span>{item.label}</span>
                      <span class="text-[11px] font-medium px-1.5 py-0.5 rounded bg-orange-100 dark:bg-orange-900/50 text-orange-800 dark:text-orange-300">
                        {item.tag}
                      </span>
                    </a>
                    {idx < OVERVIEW_FOUNDATIONS.length - 1 && (
                      <span
                        class="text-orange-600 dark:text-orange-400 font-bold select-none"
                        aria-hidden="true"
                      >
                        +
                      </span>
                    )}
                  </>
                ))
              }
            </div>
          </div>

          <!-- Branching SVG Connectors -->
          <div class="hidden md:block w-full max-w-4xl mx-auto h-12" aria-hidden="true">
            <svg
              viewBox="0 0 900 48"
              fill="none"
              class="w-full h-full text-orange-500/60 dark:text-orange-400/50"
              preserveAspectRatio="none"
            >
              <path
                d="M450 0 V20 M150 20 H750 M150 20 V44 M450 20 V44 M750 20 V44"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
              />
              <path d="M144 38 L150 46 L156 38" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M444 38 L450 46 L456 38" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              <path d="M744 38 L750 46 L756 38" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div class="flex md:hidden justify-center py-2.5 text-orange-600 dark:text-orange-400" aria-hidden="true">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v14m0 0l-5-5m5 5l5-5" />
            </svg>
          </div>

          <!-- Stage 2: 3 Specialization Tracks -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 sm:gap-5 text-left">
            {
              OVERVIEW_TRACKS.map((track) => (
                <div
                  class={`rounded-2xl p-4 sm:p-5 bg-gray-50/90 dark:bg-stone-900/70 border ${track.borderClass} flex flex-col`}
                >
                  <div class="flex items-center justify-between gap-2 mb-2">
                    <span class={`px-2.5 py-0.5 rounded-full text-xs font-bold ${track.badgeClass}`}>
                      {track.id}
                    </span>
                    <span class="text-xs font-medium text-gray-600 dark:text-gray-400">
                      {track.subtitle}
                    </span>
                  </div>
                  <h3 class="text-lg font-bold text-gray-900 dark:text-white mb-3">
                    {track.title}
                  </h3>
                  <div class="space-y-2 mt-auto">
                    {track.steps.map((step, i) => (
                      <a
                        href={step.href}
                        class={`flex items-center justify-between gap-2 px-3 py-2 rounded-xl bg-white dark:bg-stone-950/70 border border-gray-200/80 dark:border-stone-800 text-xs sm:text-sm font-medium text-gray-800 dark:text-gray-200 ${track.stepHover} transition-colors`}
                      >
                        <span class="flex items-center gap-2 min-w-0">
                          <span class="font-mono text-[11px] font-bold text-gray-500 dark:text-gray-400">
                            0{i + 1}
                          </span>
                          <span class="truncate">{step.label}</span>
                        </span>
                        <span class="text-gray-400 shrink-0" aria-hidden="true">→</span>
                      </a>

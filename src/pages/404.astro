---
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";
import { courseRootRedirects } from "../lib/course-stats.mjs";

// Starlight renders `title` as the page's only <h1>. The old page added a
// second one, loaded its image from /src/assets/hero.svg (src/ is never
// served, so it was broken in production), and offered only history.back(),
// which does nothing for someone who arrived from a bad link.
const links = [
  { href: "/", label: "ပင်မစာမျက်နှာ", hint: "Home" },
  { href: "/courses", label: "သင်ခန်းစာများ", hint: "Courses" },
  { href: "/cheatsheets", label: "Cheat Sheets", hint: "Commands" },
];
---

<StarlightPage
  frontmatter={{
    title: "စာမျက်နှာကို မတွေ့ပါ",
    description: "ဒီလိပ်စာမှာ စာမျက်နှာ မရှိပါ။",
    tableOfContents: false,
    pagefind: false,
    head: [{ tag: "meta", attrs: { name: "robots", content: "noindex" } }],
  }}
  hasSidebar={false}
>
  {/*
    "/git-course" gets a real 301 at the edge, but that rule cannot also match
    "/git-course/", which lands here. Forward exactly those course roots and
    nothing else, so genuine 404s still show this page.
  */}
  <script is:inline define:vars={{ redirects: courseRootRedirects }}>
    const target = redirects[location.pathname.replace(/\/+$/, "")];
    if (target) location.replace(target + location.search + location.hash);
  </script>

  <div class="not-found not-content">
    <img src="/favicon.svg" alt="" width="96" height="96" class="not-found-logo" />
    <p class="not-found-code" aria-hidden="true">404</p>
    <p class="not-found-text">
      ဒီလိပ်စာမှာ စာမျက်နှာ မရှိပါ။ လိပ်စာကို ပြန်စစ်ပါ၊ သို့မဟုတ် အောက်ပါ နေရာများမှ ဆက်သွားပါ။
    </p>
    <ul class="not-found-links" role="list">
      {
        links.map((link) => (
          <li>
            <a href={link.href}>
              <span class="not-found-link-label">{link.label}</span>
              <span class="not-found-link-hint">{link.hint}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="not-found-search">
      သင်ခန်းစာတစ်ခုကို ရှာနေလျှင် အပေါ်ရှိ Search ကို သုံးပါ။
    </p>
  </div>
</StarlightPage>

<style>
  .not-found {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    padding-block: 2rem 3rem;
    text-align: center;
  }

  .not-found-logo {
    width: 96px;
    height: 96px;
  }

  .not-found-code {
    margin: 0;
    font-size: clamp(3rem, 12vw, 5rem);
    font-weight: 700;
    line-height: 1;
    color: var(--sl-color-accent-high);
  }

  .not-found-text {
    max-width: 32rem;
    margin: 0;
    line-height: 1.9;
    color: var(--sl-color-gray-2);
  }

  .not-found-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 0.75rem;
    width: min(100%, 32rem);
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .not-found-links a {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    color: var(--sl-color-white);
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .not-found-links a:hover,
  .not-found-links a:focus-visible {
    border-color: var(--sl-color-accent);
  }

  .not-found-link-label {
    font-weight: 600;
  }

  .not-found-link-hint {
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }

  .not-found-search {
    margin: 0.5rem 0 0;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
</style>

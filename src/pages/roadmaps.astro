---
import StandaloneLayout from "../layouts/StandaloneLayout.astro";

const roadmaps = [
  {
    id: "fullstack",
    title: "Full-Stack Web Developer Path",
    titleBurmese: "Full-Stack Web Developer လမ်းကြောင်း",
    badge: "Most Popular",
    color: "from-amber-500 to-orange-500",
    borderColor: "border-amber-500/30",
    bgGlow: "bg-amber-500/10",
    description: "HTML မီးရိုးမှသည် Modern Full-Stack (Next.js, Node.js) Application များ တည်ဆောက်နိုင်သည်အထိ အဆင့်ဆင့် လေ့လာရန် လမ်းကြောင်း။",
    steps: [
      { step: "01", title: "HTML Fundamentals", slug: "/html/introduction/welcome-to-html", desc: "Web ၏ အခြေခံ အရိုးဆောက်တည်ပုံ" },
      { step: "02", title: "CSS & Modern Styling", slug: "/css/introduction/welcome", desc: "Flexbox, Grid နှင့် Responsive Web Design" },
      { step: "03", title: "JavaScript Essentials", slug: "/javascript/introduction/intro", desc: "DOM Manipulation, Events & Async JS" },
      { step: "04", title: "TypeScript Mastery", slug: "/typescript/module-1", desc: "Type Safety, Interfaces & Generics" },
      { step: "05", title: "Node.js & Backend APIs", slug: "/nodejs/module-1", desc: "REST APIs, Express & Server-side Logic" },
      { step: "06", title: "Next.js Full-Stack", slug: "/nextjs/introduction/what-is-nextjs", desc: "App Router, RSC, Server Actions & Vercel Deploy" },
    ]
  },
  {
    id: "ai-automation",
    title: "AI & Business Automation Path",
    titleBurmese: "AI & Business Automation လမ်းကြောင်း",
    badge: "2026 In-Demand",
    color: "from-purple-500 to-indigo-500",
    borderColor: "border-purple-500/30",
    bgGlow: "bg-purple-500/10",
    description: "AI Tools, n8n Automation Workflows, Python Scripting နှင့် Docker Containerization တို့ဖြင့် Business Ops များကို အလိုအလျောက် ပြုလုပ်ခြင်း။",
    steps: [
      { step: "01", title: "AI Proficiency & Prompting", slug: "/ai-proficiency/foundations/introduction", desc: "ChatGPT, Claude & AI Workflows မိတ်ဆက်" },
      { step: "02", title: "n8n Workflow Automation", slug: "/n8n-course/introduction/workflow-vs-agent", desc: "Telegram Bots, API Integrations & AI Agents" },
      { step: "03", title: "Python Programming", slug: "/python/module-0", desc: "Automation Scripting & Data Handling" },
      { step: "04", title: "Docker & Containerization", slug: "/docker/introduction/what-is-docker", desc: "VPS Self-hosting & Multi-container Deployments" },
      { step: "05", title: "Linux & Cloud DevOps", slug: "/linux-devops/01-cli-basics/01-navigation-and-files", desc: "Ubuntu Server, Nginx Reverse Proxy, SSL & GitHub Actions CI/CD" },
    ]
  },
  {
    id: "architecture",
    title: "Backend & Systems Architect Path",
    titleBurmese: "Backend & Software Architect လမ်းကြောင်း",
    badge: "Advanced Level",
    color: "from-blue-500 to-cyan-500",
    borderColor: "border-blue-500/30",
    bgGlow: "bg-blue-500/10",
    description: "Database Design, System Scaling, Web Performance နှင့် Distributed Architecture ရေးဆွဲနိုင်မည့် Senior-level လမ်းကြောင်း။",
    steps: [
      { step: "01", title: "SQL Fundamentals", slug: "/sql-course/introduction/what-is-sql", desc: "Queries, Joins, Aggregations & Database CRUD" },
      { step: "02", title: "Relational Database Design", slug: "/relational-database/introduction/welcome-to-database", desc: "Normalization (1NF-5NF) & Primary/Foreign Keys" },
      { step: "03", title: "MongoDB (NoSQL)", slug: "/mongodb-course/introduction/what-is-mongodb", desc: "Document Stores, Aggregations & Atlas Cloud" },
      { step: "04", title: "Linux & Server Hardening", slug: "/linux-devops/03-server-security/01-ssh-keys-and-access", desc: "SSH Keys, UFW Firewall & Nginx Reverse Proxy" },
      { step: "05", title: "Web Performance Optimization", slug: "/web-performance/introduction/why-web-performance", desc: "Core Web Vitals, Caching, Bundle Optimization" },
      { step: "06", title: "Software Architecture & Systems", slug: "/software-architecture/foundations/foundations", desc: "Monolith vs Microservices, C4 Model & ADRs" },
    ]
  }
];
---
<StandaloneLayout
  title="Learning Roadmaps"
  description="Curated career learning paths for Myanmar developers and tech enthusiasts - Full-Stack, AI Automation, and Systems Architecture"
>
  <div class="neo-page neo-roadmaps min-h-screen">
    <!-- Header -->
    <div
      class="relative overflow-hidden border-b border-gray-100 dark:border-stone-900"
    >
      <div
        class="absolute inset-x-0 -top-24 h-64 bg-gradient-to-b from-orange-500/10 to-transparent blur-2xl"
      >
      </div>
      <div
        class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-14 pb-10 text-center"
      >
        <div
          class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-orange-500/10 text-orange-600 dark:text-orange-400 font-semibold text-xs uppercase tracking-wider mb-5"
        >
          🗺️ Guided Career Paths
        </div>
        <h1
          class="text-3xl sm:text-5xl font-extrabold text-gray-900 dark:text-white tracking-tight mb-4"
        >
          Takkatho <span
            class="bg-gradient-to-r from-orange-500 to-amber-500 bg-clip-text text-transparent"
            >Learning Roadmaps</span
          >
        </h1>
        <p
          class="text-base sm:text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto leading-relaxed"
        >
          ဘယ်ကနေ စတင် လေ့လာရမှန်း မသိဖြစ်နေပါသလား? မိမိ သွားလိုသော နည်းပညာ
          လမ်းကြောင်းအလိုက် အဆင့်ဆင့် ရွေးချယ် လေ့လာနိုင်ပါသည်။
        </p>

        <!-- Quick jump -->
        <div class="mt-8 flex flex-wrap items-center justify-center gap-2.5">
          {
            roadmaps.map((roadmap) => (
              <a
                href={`#${roadmap.id}`}
                class={`inline-flex items-center gap-2 rounded-full px-4 py-2 text-xs font-semibold text-white bg-gradient-to-r ${roadmap.color} shadow-md transition-transform hover:-translate-y-0.5`}
              >
                <span>{roadmap.title.replace(" Path", "")}</span>
                <span class="rounded-full bg-black/15 px-1.5 tabular-nums">
                  {roadmap.steps.length}
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </div>

    <!-- Roadmap Cards -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14">
      <div class="space-y-14">
        {
          roadmaps.map((roadmap) => (
            <section
              id={roadmap.id}
              class={`relative scroll-mt-24 overflow-hidden rounded-3xl border ${roadmap.borderColor} bg-white p-6 shadow-lg transition-shadow duration-300 hover:shadow-2xl sm:p-10 dark:bg-stone-900/60`}
            >
              <div
                class={`pointer-events-none absolute -right-24 -top-24 h-64 w-64 rounded-full ${roadmap.bgGlow} blur-3xl`}
              />

              <!-- Roadmap Title & Description -->
              <div class="relative mb-8 border-b border-gray-100 pb-6 dark:border-stone-800">
                <span
                  class={`mb-3 inline-block rounded-md bg-gradient-to-r px-3 py-1 text-xs font-bold uppercase tracking-wider text-white ${roadmap.color}`}
                >
                  {roadmap.badge}
                </span>
                <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
                  {roadmap.titleBurmese}
                </h2>
                <p class="mt-1 text-base font-normal text-gray-500 dark:text-gray-400">
                  {roadmap.title}
                </p>
                <p class="mt-4 max-w-3xl text-sm leading-relaxed text-gray-600 dark:text-gray-400">
                  {roadmap.description}
                </p>
                <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-600 dark:bg-stone-800 dark:text-stone-300">
                  {roadmap.steps.length} အဆင့် · အစမှ အဆုံး
                </p>
              </div>

              <!-- Steps Grid -->
              <ol class="relative grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
                {roadmap.steps.map((item) => (
                  <li class="flex">
                    <a
                      href={item.slug}
                      class="group flex w-full flex-col justify-between rounded-2xl border border-gray-200/80 bg-gray-50 p-5 transition-all duration-200 hover:-translate-y-1 hover:border-orange-400/60 hover:bg-white hover:shadow-lg dark:border-stone-700/50 dark:bg-stone-800/40 dark:hover:border-orange-500/40 dark:hover:bg-stone-800"
                    >
                      <div>
                        <div class="mb-3 flex items-center justify-between">
                          <span
                            class={`rounded-full bg-gradient-to-r px-2.5 py-1 text-xs font-black text-white ${roadmap.color}`}
                          >
                            STEP {item.step}
                          </span>
                          <svg
                            class="h-5 w-5 text-gray-400 transition-all group-hover:translate-x-0.5 group-hover:text-orange-500"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M14 5l7 7m0 0l-7 7m7-7H3"
                            />
                          </svg>
                        </div>
                        <h3 class="text-lg font-bold text-gray-900 transition-colors group-hover:text-orange-500 dark:text-white">
                          {item.title}
                        </h3>
                        <p class="mt-2 text-xs leading-relaxed text-gray-500 dark:text-gray-400">
                          {item.desc}
                        </p>
                      </div>
                      <div class="mt-4 flex items-center gap-1 border-t border-gray-100 pt-3 text-xs font-semibold text-orange-600 dark:border-stone-700/40 dark:text-orange-400">
                        သင်ခန်းစာ သို့သွားမည် →
                      </div>
                    </a>
                  </li>
                ))}
              </ol>
            </section>
          ))
        }
      </div>

      <!-- Closing CTA -->
      <div
        class="neo-cta-panel mt-16 flex flex-col items-center gap-5 bg-gradient-to-br from-orange-500/10 via-amber-500/5 to-transparent px-6 py-12 text-center"
      >
        <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl dark:text-white">
          လမ်းကြောင်း ရွေးပြီးသွားပါက
        </h2>
        <p class="max-w-xl text-sm text-gray-600 dark:text-gray-400">
          သင်တန်းအားလုံးကို စာရင်းအလိုက် ကြည့်နိုင်ပါသည်။ အလုပ်လုပ်နေစဉ်
          Command များ အမြန်ရှာဖွေရန် Cheat Sheets ကို သုံးပါ။
        </p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <a
            href="/courses"
            class="neo-btn inline-flex items-center justify-center gap-2 bg-orange-500 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-orange-500/25 transition-all hover:bg-orange-600"
          >
            သင်တန်းအားလုံး ကြည့်မည် →
          </a>
          <a
            href="/cheatsheets"
            class="neo-btn inline-flex items-center justify-center gap-2 border border-gray-200 bg-white/80 px-7 py-3.5 text-sm font-semibold text-gray-800 backdrop-blur-md transition-all hover:border-orange-500/50 dark:border-stone-800 dark:bg-stone-900/80 dark:text-gray-200"
          >
            ⚡ Cheat Sheets
          </a>
        </div>
      </div>
    </div>
  </div>
</StandaloneLayout>

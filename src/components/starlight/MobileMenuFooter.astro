---
import NovaMobileMenuFooter from "starlight-theme-nova/components/MobileMenuFooter.astro";
---

<nav aria-label="Site navigation" class="sl-mobile-site-nav">
  <a href="/">Home</a>
  <a href="/courses">Courses</a>
  <a href="/roadmaps">Roadmaps</a>
  <a href="/cheatsheets">Cheat Sheets</a>
  <a href="/request-course">Request a course</a>
  <a href="/about">About</a>
</nav>

<NovaMobileMenuFooter />

<style>
  .sl-mobile-site-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--sl-color-hairline-light, rgba(120, 113, 108, 0.25));
    border-bottom: 1px solid var(--sl-color-hairline-light, rgba(120, 113, 108, 0.25));
    margin-top: 0.5rem;
  }

  .sl-mobile-site-nav a {
    font-size: 0.875rem;
    font-weight: 500;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-6, rgba(120, 113, 108, 0.12));
    transition:
      color 0.15s ease,
      background-color 0.15s ease;
  }

  .sl-mobile-site-nav a:hover {
    color: var(--sl-color-text-accent);
    background: rgba(234, 88, 12, 0.12);
  }
</style>

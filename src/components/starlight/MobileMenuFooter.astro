---
import Default from "@astrojs/starlight/components/MobileMenuFooter.astro";

const links = [
  { label: "Home", href: "/" },
  { label: "Courses", href: "/courses" },
  { label: "Roadmaps", href: "/roadmaps" },
  { label: "Cheat Sheets", href: "/cheatsheets" },
  { label: "About", href: "/about" },
];
---

<nav class="sl-mobile-site-nav" aria-label="Site navigation">
  <div class="sl-mobile-site-nav-label">Takkatho Menu</div>
  <div class="sl-mobile-site-nav-links">
    {
      links.map((link) => (
        <a href={link.href} class="sl-mobile-site-nav-link">
          {link.label}
        </a>
      ))
    }
  </div>
</nav>

<Default />

<style>
  .sl-mobile-site-nav {
    border-top: 1px solid var(--sl-color-gray-6);
    padding: 0.75rem 0;
    margin-top: 0.5rem;
  }

  .sl-mobile-site-nav-label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-3);
    margin-bottom: 0.5rem;
  }

  .sl-mobile-site-nav-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem;
  }

  .sl-mobile-site-nav-link {
    display: block;
    padding: 0.45rem 0.65rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--sl-color-gray-2);
    background-color: var(--sl-color-gray-6);
    text-decoration: none;
    transition: background-color 0.15s ease, color 0.15s ease;
  }

  .sl-mobile-site-nav-link:hover {
    color: var(--sl-color-white);
    background-color: var(--sl-color-gray-5);
  }
</style>

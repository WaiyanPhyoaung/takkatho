---
import NovaMarkdownContent from "starlight-theme-nova/components/MarkdownContent.astro";
import LessonCompletion from "@/components/mdx/LessonCompletion";
import { courses } from "@/lib/course-stats.mjs";

const LEGACY_COMPLETION_IDS: Record<string, string> = {
  "/docker/introduction/what-is-docker": "docker-01-intro",
  "/linux-devops/01-cli-basics/01-navigation-and-files": "linux-devops-01-navigation",
  "/linux-devops/01-cli-basics/02-permissions-and-users": "linux-devops-02-permissions",
  "/linux-devops/02-system-management/01-package-management": "linux-devops-03-packages",
  "/linux-devops/02-system-management/02-processes-and-services": "linux-devops-04-processes-systemd",
  "/linux-devops/03-server-security/01-ssh-keys-and-access": "linux-devops-05-ssh-hardening",
  "/linux-devops/03-server-security/02-firewall-and-hardening": "linux-devops-06-firewall-swap",
  "/linux-devops/04-nginx-reverse-proxy/01-nginx-fundamentals": "linux-devops-07-nginx-basics",
  "/linux-devops/04-nginx-reverse-proxy/02-reverse-proxy-and-ssl": "linux-devops-08-reverse-proxy-ssl",
  "/linux-devops/05-cicd-automation/01-github-actions-basics": "linux-devops-09-github-actions",
  "/linux-devops/05-cicd-automation/02-automated-vps-deployment": "linux-devops-10-automated-deployment",
};

const route = Astro.locals.starlightRoute;
const cleanPath = Astro.url.pathname.replace(/\/$/, "");
const segments = cleanPath.split("/").filter(Boolean);
const courseDirs = new Set(courses.map((c) => c.dir));
const isLessonPage = segments.length >= 2 && courseDirs.has(segments[0]);
const lessonTitle = route?.entry?.data?.title ?? "";
const legacyId = LEGACY_COMPLETION_IDS[cleanPath];
---

<NovaMarkdownContent>
  <slot />
</NovaMarkdownContent>

{
  isLessonPage && (
    <LessonCompletion
      client:idle
      lessonId={cleanPath}
      lessonTitle={lessonTitle}
      legacyId={legacyId}
    />
  )
}

<script>
  const renderMermaidDiagrams = async () => {
    const preBlocks = document.querySelectorAll<HTMLPreElement>(
      ".mermaid-container pre.mermaid",
    );
    if (preBlocks.length === 0) return;

    const { default: mermaid } = await import("mermaid");
    const isDark = document.documentElement.dataset.theme === "dark";

    mermaid.initialize({
      startOnLoad: false,
      theme: isDark ? "dark" : "default",
      securityLevel: "loose",
      fontFamily: '"Noto Sans Myanmar", "Geist", system-ui, sans-serif',
      themeVariables: isDark
        ? {
            primaryColor: "#ea580c",
            primaryTextColor: "#f5f5f4",
            primaryBorderColor: "#fb923c",
            lineColor: "#a8a29e",
            secondaryColor: "#292524",
            tertiaryColor: "#1c1917",
          }
        : {
            primaryColor: "#fff7ed",
            primaryTextColor: "#1c1917",
            primaryBorderColor: "#ea580c",
            lineColor: "#57534e",
            secondaryColor: "#ffedd5",
            tertiaryColor: "#fafaf9",
          },
    });

    for (const pre of preBlocks) {
      const source = pre.dataset.mermaidSrc || pre.textContent || "";
      if (!source.trim()) continue;
      if (!pre.dataset.mermaidSrc) {
        pre.dataset.mermaidSrc = source;
      }

      pre.removeAttribute("data-processed");
      pre.textContent = source;
      pre.closest(".mermaid-container")?.classList.remove("is-rendered");
    }

    await mermaid.run({
      nodes: Array.from(preBlocks),
    });

    for (const pre of preBlocks) {
      if (pre.getAttribute("data-processed") === "true" || pre.querySelector("svg")) {
        pre.closest(".mermaid-container")?.classList.add("is-rendered");
      }
    }
  };

  let lastTheme = document.documentElement.dataset.theme;
  const observer = new MutationObserver(() => {
    const currentTheme = document.documentElement.dataset.theme;
    if (currentTheme !== lastTheme) {
      lastTheme = currentTheme;
      renderMermaidDiagrams();
    }
  });

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", renderMermaidDiagrams);
  } else {
    renderMermaidDiagrams();
  }

  observer.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
